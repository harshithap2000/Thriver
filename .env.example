# Copy to .env.local and adjust. Only VITE_-prefixed vars are exposed to the client.
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com

# Records assistant (server-side only; never prefix with VITE_). Put your real key in .env.local.
# ANTHROPIC_API_KEY=sk-ant-...

# Supabase: accounts and backup (optional; without these the app stays on-device only).
# Local stack: run `pnpm db:start` and copy the API URL and publishable key it prints.
# Hosted project: Project Settings → API keys. The publishable key is safe in the browser;
# never put the secret (service role) key here.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
